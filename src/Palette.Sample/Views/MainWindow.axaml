<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Palette.Sample.ViewModels"
        xmlns:views="using:Palette.Sample.Views"
        x:Class="Palette.Sample.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1240" Height="820" MinWidth="880" MinHeight="560"
        Background="{DynamicResource FormBgBrush}"
        Foreground="{DynamicResource FgBrush}"
        Title="Avalonia Palette — eye-strain-friendly theming template">

    <Window.Styles>
        <!-- Nav rail rows -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.navitem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pointerover Border.navitem">
            <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
        </Style>
        <Style Selector="Border.navitem.active">
            <Setter Property="Background" Value="{DynamicResource NavItemActiveBgBrush}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="228,*">

        <!-- ── Left: nav rail ─────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14" Spacing="2">
                    <TextBlock Text="Avalonia Palette" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TitleBrush}" />
                    <TextBlock Text="theming template" FontSize="11"
                               Foreground="{DynamicResource FaintBrush}" LetterSpacing="1.5" />
                </StackPanel>

                <!-- WCAG chip pinned to the bottom -->
                <Border DockPanel.Dock="Bottom" Margin="14,10,14,16"
                        CornerRadius="8" Padding="12,9"
                        Background="{DynamicResource SurfaceSunkenBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="ACTIVE PALETTE" Classes="phead" />
                        <TextBlock Text="{Binding CurrentPaletteName}" Classes="field" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding CurrentPassesAa, Converter={x:Static views:BoolText.AaPass}}"
                                       Classes="status"
                                       Classes.ok="{Binding CurrentPassesAa}"
                                       Classes.warn="{Binding !CurrentPassesAa}"
                                       FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,4,0,8">
                        <ItemsControl.DataTemplates>

                            <DataTemplate x:CompileBindings="False" DataType="vm:NavHeaderViewModel">
                                <TextBlock Text="{Binding Label}" Classes="phead"
                                           Margin="20,16,20,6" />
                            </DataTemplate>

                            <DataTemplate x:CompileBindings="False" DataType="vm:PageViewModel">
                                <Button Classes="nav"
                                        Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="navitem" Classes.active="{Binding IsActive}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Glyph}" FontSize="14" Width="18"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource NavIndicatorBrush}" />
                                            <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource FgBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>

                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Right: top bar + content ───────────────────────────────── -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding CurrentPage.Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" />
                        <TextBlock Text="{Binding CurrentPage.Blurb}" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Palette" Classes="help" VerticalAlignment="Center" />
                        <ComboBox Width="210"
                                  ItemsSource="{Binding Palettes}"
                                  SelectedItem="{Binding SelectedPalette}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaletteChoiceViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="30" Height="16" CornerRadius="3"
                                                Background="{Binding SurfaceSwatch}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Border Width="8" Height="8" CornerRadius="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding AccentSwatch}" />
                                        </Border>
                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="secondary" Command="{Binding ToggleVariantCommand}"
                                Content="Light / Dark" ToolTip.Tip="Jump to the light or dark sibling of this palette" />
                        <CheckBox IsChecked="{Binding FollowOs}" Content="Follow OS"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Track the system light/dark setting for this palette family" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" />
        </DockPanel>
    </Grid>
</Window>
