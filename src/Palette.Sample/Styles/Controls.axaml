<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Shared control themes for the whole app. Everything resolves colours via
      {DynamicResource <token>}; because ThemeManager mutates those brushes in place on a
      palette swap, every surface styled here recolours live with no code behind.
      This is the single stylesheet the author's apps currently duplicate per-view.
    -->

    <Styles.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Code,Consolas,Menlo,monospace</FontFamily>
    </Styles.Resources>

    <!-- ── Typography ─────────────────────────────────────────────────── -->
    <Style Selector="TextBlock.pagetitle">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.phead">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.help">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.field">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>

    <!-- Status text classes: Classes="status ok|warn|err|info" -->
    <Style Selector=":is(TextBlock).status.ok">
        <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).status.warn">
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).status.err">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).status.info">
        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
    </Style>

    <!-- ── Surfaces ───────────────────────────────────────────────────── -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,18" />
    </Style>
    <Style Selector="Border.well">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- ── Buttons ────────────────────────────────────────────────────── -->
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Primary / accent -->
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- Secondary / neutral -->
    <Style Selector="Button.secondary">
        <Setter Property="Foreground" Value="{DynamicResource ButtonNeutralTextBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonNeutralBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonNeutralTextBrush}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonNeutralHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonNeutralTextBrush}" />
    </Style>

    <!-- Danger -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Link -->
    <Style Selector="Button.link">
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <!-- ── Alert banners: Border.alert + .ok|.warn|.err|.info ─────────── -->
    <Style Selector="Border.alert">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style Selector="Border.alert.info">
        <Setter Property="Background" Value="{DynamicResource InfoBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
    </Style>
    <Style Selector="Border.alert.ok">
        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="Border.alert.warn">
        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="Border.alert.err">
        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- ── Badge (small pill) ─────────────────────────────────────────── -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- ── Editable "text area" demo surface ──────────────────────────── -->
    <Style Selector="TextBox.editor">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource EditorFgBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource EditorCaretBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource EditorSelectionBrush}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBox.editor /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource EditorBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <!-- ── Separator hairline ─────────────────────────────────────────── -->
    <Style Selector="Border.hr">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
    </Style>

</Styles>
