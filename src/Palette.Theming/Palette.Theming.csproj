<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ArcticGizmo.Avalonia.Palette</RootNamespace>
    <AssemblyName>ArcticGizmo.Avalonia.Palette</AssemblyName>
    <!-- This is a reusable theming library other Avalonia apps reference. It layers the
         Avalonia live-swap engine (ThemeManager, Rgb→brush bridge) over the UI-free
         Palette.Core package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- ── NuGet package metadata ──────────────────────────────────────────
       Produce with:  dotnet pack src/Palette.Theming -c Release
       Consumers then:  dotnet add package Palette.Theming
       Update PackageId / RepositoryUrl / license before publishing publicly. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ArcticGizmo.Avalonia.Palette</PackageId>
    <Version>0.3.0</Version>
    <Authors>ArcticGizmo</Authors>
    <Company>ArcticGizmo</Company>
    <Title>Avalonia Palette — eye-strain-friendly theming</Title>
    <Description>Runtime-swappable, WCAG-AA colour palettes for Avalonia apps: ~70 semantic tokens, a live ThemeManager that recolours in place, WCAG contrast utilities, optional per-user persistence, and 18 built-in palettes (9 families x light/dark) tuned for long editing sessions.</Description>
    <PackageTags>avalonia;theme;theming;palette;colors;wcag;accessibility;dark-mode;light-mode;syntax</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ArcticGizmo/avalonia-pallete</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArcticGizmo/avalonia-pallete</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>0.3.0 — BREAKING: root namespace is now ArcticGizmo.Avalonia.Palette (was Palette.Theming); update your usings. The UI-free model now ships in the ArcticGizmo.Avalonia.Palette.Core package (auto-referenced). New: consumer-registerable + pinned tokens (ThemeManager.RegisterTokens/TokenSpec), ThemeManager.Current.Rgb(token), manageFluentVariant opt-out, PaletteCatalog.Find, PaletteCodec share codes, ThemeTokens.Error alias, floating Avalonia [12.0.5,13.0.0).</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Ship the agent guide inside the package so it lands on disk with the restored package
         (some AI agent setups index that), in addition to being hosted in the repo. -->
    <None Include="..\..\AGENTS.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Base Avalonia only; consumers bring Desktop/Browser/etc. heads themselves.
         Floating range (not an exact pin) so consumers on a newer 12.x don't have to
         lockstep-downgrade to match us. -->
    <PackageReference Include="Avalonia" Version="[12.0.5,13.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI-free model. Packs as a NuGet dependency (ArcticGizmo.Avalonia.Palette.Core)
         so consumers restore both. -->
    <ProjectReference Include="..\Palette.Core\Palette.Core.csproj" />
  </ItemGroup>

</Project>
