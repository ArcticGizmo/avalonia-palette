<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Palette.Theming</RootNamespace>
    <AssemblyName>Palette.Theming</AssemblyName>
    <!-- This is a reusable theming library other Avalonia apps reference. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base Avalonia only; consumers bring Desktop/Browser/etc. heads themselves. -->
    <PackageReference Include="Avalonia" Version="12.0.5" />
  </ItemGroup>

</Project>
